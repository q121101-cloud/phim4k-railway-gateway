# Cấu hình cổng server
PORT=8080

# Hugging Face Repository mặc định (Dạng: username/repo-name)
HF_REPO=your-username/ai-weights-v1

# Hugging Face Read/Write Token (Chỉ cần nếu Repo ở chế độ Private)
HF_TOKEN=

# Khóa salt bí mật để ký và xác thực token (Mặc định chuẩn 4ke: 95bd6bf2)
SECRET_SALT=95bd6bf2

# Chế độ streaming:
# - 'redirect' (Khuyên dùng - Đúng chuẩn 4ke): Trả về HTTP 302 chuyển hướng sang HF CDN, $0 phí băng thông Railway
# - 'proxy': Railway kéo dữ liệu từ HF rồi stream về client, ghi đè Content-Type thành video/mp4
STREAM_MODE=redirect

# Danh bạ ánh xạ File ID -> Hugging Face URL nếu dùng nhiều repo khác nhau (JSON String)
# Ví dụ: REPO_MAP={"movie1":"https://huggingface.co/user1/repo1/resolve/main/movie1.pth"}
REPO_MAP={}
